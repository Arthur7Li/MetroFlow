{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "WebWorker"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/core/contracts.ts",
    "src/core/worker.ts",
    "src/core/memory/**/*",
    "src/core/stores/**/*",
    "src/config/**/*",
    "src/cities/types.ts"
  ]
}
